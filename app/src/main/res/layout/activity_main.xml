<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3c052a"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/AutorizationText"
        android:layout_width="201dp"
        android:layout_height="46dp"
        android:text="Авторизация"
        android:textColor="@color/white"
        android:textSize="30sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.178" />

    <EditText
        android:id="@+id/UserNameLogInScreen"
        android:layout_width="268dp"
        android:layout_height="74dp"
        android:layout_marginTop="32dp"
        android:ems="10"
        android:hint="Логин или почта"
        android:inputType="text"
        android:textColor="@color/white"
        android:text=""
        android:textColorHint="#9B8B8B"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/AutorizationText" />

    <Button
        android:id="@+id/LogInButton"
        android:layout_width="128dp"
        android:layout_height="53dp"
        android:layout_marginTop="24dp"
        android:text="Войти"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/UserPasswordLogInScreen"
        app:rippleColor="#FAFAFA" />

    <Button
        android:id="@+id/ToRegInScreenButton"
        android:layout_width="196dp"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:text="Регистрация"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/NoAccountText"
        tools:ignore="MissingConstraints" />

    <EditText
        android:id="@+id/UserPasswordLogInScreen"
        android:layout_width="269dp"
        android:layout_height="59dp"
        android:layout_marginTop="28dp"
        android:ems="10"
        android:hint="Пароль"
        android:inputType="text"
        android:textColor="@color/white"
        android:text=""
        android:textColorHint="#A69191"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/UserNameLogInScreen"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/NoAccountText"
        android:layout_width="149dp"
        android:layout_height="43dp"
        android:layout_marginTop="116dp"
        android:text="Нет аккаунта?"
        android:textColor="@color/white"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/LogInButton" />

</androidx.constraintlayout.widget.ConstraintLayout>